---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import Pic from './Pic.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const facts = (s.facts ?? []).filter((f: any) => f?.label || f?.value);
---
<Sec node={node} edit={edit} class:list={['case', s.side === 'right' && 'case--right']}>
  <div class="case__media frame ratio-tall"><Pic img={s.image} edit={edit} /></div>
  <div class="case__body stack">
    {s.eyebrow && <p class="eyebrow" {...fieldAttrs(edit, 'eyebrow', 'text')}>{s.eyebrow}</p>}
    <h2 {...fieldAttrs(edit, 'title', 'text')} set:html={s.title ?? ''} />
    {facts.length > 0 && <dl class="facts">{facts.map((f: any) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>}
    {s.text && <div class="rich" {...fieldAttrs(edit, 'text', 'richtext')} set:html={s.text} />}
    {s.quote && (
      <figure class="case__quote">
        <blockquote class="rich" {...fieldAttrs(edit, 'quote', 'richtext')} set:html={s.quote} />
        {s.cite && <figcaption class="muted" {...fieldAttrs(edit, 'cite', 'text')}>{s.cite}</figcaption>}
      </figure>
    )}
    {s.href && <p><a class="btn btn--text" href={s.href}>Read the full story <span aria-hidden="true">→</span></a></p>}
  </div>
</Sec>

---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { child, fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
---
<Sec node={node} edit={edit} class="services">
  <SecHead s={s} edit={edit} />
  <ul class="services__list">
    {(node.blocks ?? []).map((it, i) => { const ie = child(edit, i); const v = it.settings; return (
      <li class="service" {...nodeAttrs(ie, it)}>
        <div class="service__main stack stack--tight">
          <h3 {...fieldAttrs(ie, 'title', 'text')} set:html={v.title ?? ''} />
          {v.text && <div class="rich muted" {...fieldAttrs(ie, 'text', 'richtext')} set:html={v.text} />}
        </div>
        <p class="service__meta">
          {v.duration && <span class="muted" {...fieldAttrs(ie, 'duration', 'text')}>{v.duration}</span>}
          {v.price && <strong {...fieldAttrs(ie, 'price', 'text')}>{v.price}</strong>}
          {v.href && <a class="service__link" href={v.href} aria-label={`More about ${(v.title ?? '').replace(/<[^>]*>/g, '')}`}>→</a>}
        </p>
      </li>
    ); })}
  </ul>
</Sec>

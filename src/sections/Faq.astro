---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { child, fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
---
<Sec node={node} edit={edit} class:list={['faq', `faq--${s.layout || 'side'}`]}>
  <SecHead s={s} edit={edit} />
  <div class="faq__list">
    {(node.blocks ?? []).map((it, i) => { const ie = child(edit, i); return (
      <details class="faq__item" {...nodeAttrs(ie, it)} open={!!edit && i === 0}>
        <summary><span {...fieldAttrs(ie, 'question', 'text')} set:html={it.settings.question ?? ''} /><span class="faq__icon" aria-hidden="true"></span></summary>
        <div class="rich muted" {...fieldAttrs(ie, 'answer', 'richtext')} set:html={it.settings.answer ?? ''} />
      </details>
    ); })}
  </div>
</Sec>

---
// The latest articles from src/content/articles, as cards or a list. Filters by tag if one is set.
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/content';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const tag = String(s.tag ?? '').trim().toLowerCase();
const list = (await articles()).filter((a) => !tag || a.data.tags.some((t) => t.toLowerCase() === tag)).slice(0, Math.max(1, Number(s.count) || 3));
const row = s.layout === 'list';
---
<Sec node={node} edit={edit} class:list={['articles', row && 'articles--list']}>
  <div class="feed-head">
    <SecHead s={s} edit={edit} />
    {s.more && <a class="btn btn--text" href="/journal/">{s.more} <span aria-hidden="true">→</span></a>}
  </div>
  {list.length
    ? <ul class:list={[row ? 'articles__list' : 'articles__grid']} style={`--cols: ${Math.min(list.length, 3)}`}>{list.map((a) => <li><ArticleCard a={a} layout={row ? 'row' : 'card'} /></li>)}</ul>
    : edit && <p class="placeholder">No articles{tag && ` tagged “${tag}”`} yet. Add one under Journal in the editor.</p>}
</Sec>

---
// Photos in a grid or masonry. With the lightbox on, each photo is a link to the full image and
// site.ts opens it in a <dialog> with previous / next; without JavaScript the link still works.
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { child, fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
import Pic from './Pic.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const box = s.lightbox !== false && !edit;
---
<Sec node={node} edit={edit} class:list={['gallery', `gallery--${s.layout || 'grid'}`]}>
  <SecHead s={s} edit={edit} />
  <ul class="gallery__grid" style={`--cols: ${s.columns || 3}`} data-lightbox={box ? '' : undefined}>
    {(node.blocks ?? []).map((it, i) => { const ie = child(edit, i); const p = it.settings; const img = p.image ?? {}; return (
      <li class="gallery__item" {...nodeAttrs(ie, it)}>
        <figure>
          {box && img.src
            ? <a href={img.src} class="gallery__link" data-caption={p.caption || img.alt || ''}><span class="frame"><Pic img={img} edit={ie} /></span></a>
            : <span class="frame"><Pic img={img} edit={ie} /></span>}
          {p.caption && <figcaption class="muted" {...fieldAttrs(ie, 'caption', 'text')}>{p.caption}</figcaption>}
        </figure>
      </li>
    ); })}
  </ul>
</Sec>

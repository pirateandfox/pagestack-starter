---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { child, fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const single = s.layout === 'single';
---
<Sec node={node} edit={edit} class:list={['testimonials', single && 'testimonials--single']} width={single ? 'narrow' : 'normal'}>
  <SecHead s={s} edit={edit} center={single} />
  <div class="testimonials__grid">
    {(node.blocks ?? []).map((it, i) => { const ie = child(edit, i); const t = it.settings; const img = t.image ?? {}; return (
      <figure class="testimonial" {...nodeAttrs(ie, it)}>
        <blockquote class="testimonial__quote rich" {...fieldAttrs(ie, 'quote', 'richtext')} set:html={t.quote ?? ''} />
        <figcaption class="testimonial__who">
          {img.src && <img src={img.src} alt="" width="48" height="48" {...fieldAttrs(ie, 'image', 'image')} />}
          <span><strong {...fieldAttrs(ie, 'name', 'text')} set:html={t.name ?? ''} />{t.role && <span class="muted" {...fieldAttrs(ie, 'role', 'text')} set:html={t.role} />}</span>
        </figcaption>
      </figure>
    ); })}
  </div>
</Sec>

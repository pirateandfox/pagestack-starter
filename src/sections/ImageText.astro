---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import Render from './Render.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const img = s.image ?? {};
---
<Sec node={node} edit={edit} class:list={['image-text', s.side === 'right' && 'image-text--right']}>
  <figure class:list={['image-text__media frame', `ratio-${s.ratio || 'tall'}`]}>
    {img.src ? <img src={img.src} alt={img.alt ?? ''} {...fieldAttrs(edit, 'image', 'image')} /> : edit && <div class="placeholder" {...fieldAttrs(edit, 'image', 'image')}>Choose an image</div>}
  </figure>
  <div class="image-text__body stack">
    {s.eyebrow && <p class="eyebrow" {...fieldAttrs(edit, 'eyebrow', 'text')} set:html={s.eyebrow} />}
    <h2 {...fieldAttrs(edit, 'title', 'text')} set:html={s.title ?? ''} />
    {s.text && <div class="rich" {...fieldAttrs(edit, 'text', 'richtext')} set:html={s.text} />}
    {node.blocks?.length ? <div class="actions"><Render nodes={node.blocks} edit={edit} /></div> : null}
  </div>
</Sec>

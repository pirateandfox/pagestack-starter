---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import Render from './Render.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const layout = s.layout || 'split';
const img = s.image ?? {};
const center = s.align === 'center' || layout === 'image';
---
<Sec node={node} edit={edit} class={`hero hero--${layout}`} width={layout === 'image' ? 'full' : 'normal'}>
  {layout === 'image' && img.src && <img class="hero__bg" src={img.src} alt={img.alt ?? ''} {...fieldAttrs(edit, 'image', 'image')} />}
  <div class:list={['hero__inner', layout === 'image' && 'wrap', center && 'center']}>
    <div class="hero__body stack">
      {s.eyebrow && <p class="eyebrow" {...fieldAttrs(edit, 'eyebrow', 'text')} set:html={s.eyebrow} />}
      <h1 class="hero__title" {...fieldAttrs(edit, 'title', 'text')} set:html={s.title ?? ''} />
      {s.text && <div class="lede rich" {...fieldAttrs(edit, 'text', 'richtext')} set:html={s.text} />}
      {node.blocks?.length ? <div class="actions"><Render nodes={node.blocks} edit={edit} /></div> : null}
    </div>
    {layout === 'split' && img.src && (
      <figure class="hero__media frame ratio-tall"><img src={img.src} alt={img.alt ?? ''} {...fieldAttrs(edit, 'image', 'image')} /></figure>
    )}
  </div>
</Sec>

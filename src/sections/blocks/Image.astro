---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
const img = s.image ?? {};
const ratio = s.ratio && s.ratio !== 'auto' ? `ratio-${s.ratio}` : '';
---
<figure class="figure" {...nodeAttrs(edit, node)}>
  <div class:list={['frame', ratio]}>{img.src ? <img src={img.src} alt={img.alt ?? ''} {...fieldAttrs(edit, 'image', 'image')} /> : edit && <div class="placeholder" {...fieldAttrs(edit, 'image', 'image')}>Choose an image</div>}</div>
  {s.caption && <figcaption class="muted" {...fieldAttrs(edit, 'caption', 'text')} set:html={s.caption} />}
</figure>

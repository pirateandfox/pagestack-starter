---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
---
<figure class="pullquote" {...nodeAttrs(edit, node)}>
  <blockquote class="display" {...fieldAttrs(edit, 'text', 'text')} set:html={s.text ?? ''} />
  {s.cite && <figcaption class="muted" {...fieldAttrs(edit, 'cite', 'text')} set:html={s.cite} />}
</figure>

---
import type { Node, EditCtx } from '@pirateandfox/pagestack/runtime';
import { child, fieldAttrs, nodeAttrs } from '@pirateandfox/pagestack/runtime';
import Sec from './Sec.astro';
import SecHead from './SecHead.astro';
interface Props { node: Node; edit?: EditCtx }
const { node, edit } = Astro.props;
const s = node.settings;
---
<Sec node={node} edit={edit} class="timeline" width="narrow">
  <SecHead s={s} edit={edit} />
  <ol class="timeline__list">
    {(node.blocks ?? []).map((it, i) => { const ie = child(edit, i); const m = it.settings; return (
      <li class="moment" {...nodeAttrs(ie, it)}>
        <p class="moment__date" {...fieldAttrs(ie, 'date', 'text')}>{m.date}</p>
        <div class="moment__body stack stack--tight">
          <h3 {...fieldAttrs(ie, 'title', 'text')} set:html={m.title ?? ''} />
          {m.text && <div class="rich muted" {...fieldAttrs(ie, 'text', 'richtext')} set:html={m.text} />}
        </div>
      </li>
    ); })}
  </ol>
</Sec>

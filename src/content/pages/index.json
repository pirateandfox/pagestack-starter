    {
      "id": "3941db2",
      "type": "faq",
      "settings": {
        "title": "Questions people ask",
        "eyebrow": "",
        "intro": "<p>Anything else, <a href=\"/#contact\">ask us</a>.</p>",
        "layout": "side",
        "background": "default",
        "padding": "normal",
        "anchor": ""
      },
      "blocks": [
        {
          "id": "c54ddfb",
          "type": "faq-item",
          "settings": {
            "question": "How much does an architect cost?",
            "answer": "<p>For most of our projects, between 8 and 12 percent of the build cost. We agree a fixed fee before we start.</p>"
          }
        },
        {
          "id": "93a6744",
          "type": "faq-item",
          "settings": {
            "question": "Do you work outside Portwell?",
            "answer": "<p>Yes, anywhere within about two hours. Further than that, we will recommend someone local.</p>"
          }
        },
        {
          "id": "db32da2",
          "type": "faq-item",
          "settings": {
            "question": "How long does planning take?",
            "answer": "<p>Usually eight to thirteen weeks from submission. We will tell you early if a site looks difficult.</p>"
          }
        },
        {
          "id": "3a9a91e",
          "type": "faq-item",
          "settings": {
            "question": "Can you work with my builder?",
            "answer": "<p>Of course. We are happy to tender too, if you would like to compare.</p>"
          }
        }
      ]
    },

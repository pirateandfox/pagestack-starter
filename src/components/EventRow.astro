---
// One date of an event in a list. With `series`, an event that repeats says how ("Every Tuesday").
import { dayMonth, flagText, localIso, whenText, type EventDate } from '../lib/content';
import { repeatText } from '../lib/recurrence';
interface Props { o: EventDate; layout?: 'list' | 'card'; series?: boolean }
const { o, layout = 'list', series = false } = Astro.props;
const { e } = o;
const d = dayMonth(o.start);
const href = `/events/${e.id}/`;
const flag = flagText(o);
const every = series ? repeatText(e.data) : '';
---
<article class:list={['erow', `erow--${layout}`]}>
  <p class="erow__date" aria-hidden="true"><span class="erow__month">{d.month}</span><span class="erow__day">{d.day}</span><span class="erow__wd">{d.weekday}</span></p>
  <div class="erow__body">
    {flag && <p class="flag">{flag}</p>}
    <h3><a href={href}>{o.cancelled ? <s>{e.data.title}</s> : e.data.title}</a></h3>
    <p class="erow__when"><time datetime={localIso(o.start, e.data.allDay)}>{whenText(o, e.data.allDay)}</time>{every && <span>{every}</span>}{e.data.place && <span>{e.data.place}</span>}</p>
    {o.note && <p>{o.note}</p>}
    {e.data.description && <p class="muted">{e.data.description}</p>}
  </div>
  <p class="erow__act">
    {e.data.price && !o.cancelled && <span class="muted">{e.data.price}</span>}
    {e.data.tickets && !o.cancelled ? <a class="btn btn--outline" href={e.data.tickets} rel="noopener">Tickets</a> : <a class="btn btn--text" href={href}>Details</a>}
  </p>
</article>

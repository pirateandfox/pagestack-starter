---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { events } from '../../lib/content';
const list = await events();
---
<Base title="Events" description="Talks, open evenings and workshops at the studio.">
  <section class="sec page-header bg--muted"><div class="wrap"><div class="sec-head"><h1>Events</h1><p class="lede">Talks, open evenings and workshops. Everyone welcome.</p></div></div></section>
  <section class="sec">
    <div class="wrap">
      {list.length ? <ul class="events__list">{list.map((e) => <li><EventRow e={e} /></li>)}</ul> : <p class="muted">Nothing planned right now. Check back soon.</p>}
    </div>
  </section>
</Base>

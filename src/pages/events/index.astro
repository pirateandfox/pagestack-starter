---
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import Subscribe from '../../components/Subscribe.astro';
import { eventDates, overAt } from '../../lib/content';
import site from '../../data/site.json';
const list = await eventDates();
---
<Base title={site.eventsTitle} description={site.eventsIntro}>
  <section class="sec page-header bg--muted"><div class="wrap"><div class="sec-head"><h1>{site.eventsTitle}</h1>{site.eventsIntro && <p class="lede">{site.eventsIntro}</p>}</div></div></section>
  <section class="sec">
    <div class="wrap">
      {list.length > 0 && <ul class="events__list" data-events>{list.map((o) => <li data-event-end={overAt(o)}><EventRow o={o} /></li>)}</ul>}
      <p class="muted" data-events-none hidden={list.length > 0}>Nothing planned right now. Check back soon.</p>
      {list.length > 0 && <div class="events__foot"><Subscribe file="/events.ics" label="Subscribe to the calendar" /></div>}
    </div>
  </section>
</Base>
